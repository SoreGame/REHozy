    \u043F\u0440\u0438\u044F\u0442\u043D\u0430\u044F \u043C\u0443\u0437\u044B\u043A\u0430
    \u0438\u0433\u0440\u0430\u0435\u0442, \u043D\u0435 \u043C\u043E\u0433\u0443.
    \u042F \u0436\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u0447\u0442\u043E \u0432\u0441\u0435
    \u043F\u043E\u0447\u0438\u0441\u0442\u0438\u043B, \u043F\u043E\u0441\u0430\u0434\u0438\u043B
    \u0437\u0435\u043B\u0435\u043D\u0443\u0448\u043A\u0443 \u0432\u0441\u044F\u043A\u0443\u044E.
    \u0417\u0430\u0436\u0435\u0433 \u043E\u0433\u043E\u043D\u044C! \u0410 \u0441\u0435\u0439\u0447\u0430\u0441
    \u043C\u043E\u0433\u0443 \u0435\u0449\u0435 \u043E\u0431\u044A\u0435\u043A\u0442\u044B
    \u0432\u0441\u044F\u043A\u0438\u0435 \u043F\u043E\u0440\u0430\u0441\u0441\u0442\u043E\u0432\u043B\u044F\u0442\u044C.
    \u042F \u0436\u0435 \u043C\u043E\u0433\u0443 \u0441\u0434\u0435\u043B\u0430\u0442\u044C
    \u044D\u0442\u0443 \u0434\u0438\u0430\u0440\u0430\u043C\u0443 \u0435\u0449\u0435
    \u0447\u0443\u0442\u044C \u0431\u043E\u043B\u0435\u0435 \"\u0441\u0432\u043E\u0435\u0439\"!
    \u0410, \u043D\u0443 \u0438 \u043A\u043E\u043D\u0435\u0447\u043D\u043E \u043C\u043E\u0433\u0443
    \u0441\u043A\u0440\u0438\u043D\u0448\u043E\u0442\u0438\u043A \u0441\u0434\u0435\u043B\u0430\u0442\u044C,
    \u0430 \u0442\u043E \u0437\u0430\u043A\u0440\u043E\u044E \u0438 <b>\u043D\u0438\u0447\u0435\u0433\u043E
    \u043D\u0435 \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u044C\u0441\u044F</b>"
  m_isRightToLeft: 0
